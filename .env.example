# Copy to .env to override defaults. .env is gitignored. Never commit real keys.

# Whisper model: small is fast; medium was closer on one weak test recording but ~10x slower.
WHISPER_MODEL=small

# Where QR codes in the PDF point. For a phone on the same Wi-Fi, use this laptop's address,
# e.g. http://192.168.1.20:8000 (it changes per network, so regenerate the PDF after changing it).
BASE_URL=http://localhost:8000

# Seconds of extra audio kept before and after each chapter clip.
CLIP_PADDING_SECONDS=0.25

# Only if ffmpeg is not on PATH:
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# --- Optional live AI drafting (Google Gemini). Without a key the app still works offline. ---
# The key stays on the server. Only transcript TEXT is ever sent, never audio.
GEMINI_API_KEY=
# Models come and go; gemini-3.5-flash worked in testing (gemini-3.8-flash hung). List yours via the API.
GEMINI_MODEL=gemini-3.5-flash
# A real storyteller's words are only sent if they specifically agreed AND this is true.
# Set true ONLY if the key belongs to a billing-enabled Google project: Google may use text sent through
# free keys to improve its products, and people there may read it.
GEMINI_PROMPTS_NOT_USED_FOR_TRAINING=false
